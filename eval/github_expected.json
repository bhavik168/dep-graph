{
  "_about": "Hand-labeled expectations for the GitHub catalog, used ONLY to score generator output (npm run eval). The generator never reads this file. Per (consumer, param): `must` = producers an agent should find (recall); `ok` = also-acceptable producers (precision credit). Both empty = the user supplies the value, so any edge is a false positive. Slugs omit the GITHUB_ prefix.",
  "prefix": "GITHUB_",
  "cases": [
    { "consumer": "CREATE_AN_ISSUE_COMMENT", "param": "issue_number",
      "must": ["LIST_REPOSITORY_ISSUES"],
      "ok": ["SEARCH_ISSUES", "SEARCH_ISSUES_AND_PULL_REQUESTS", "LIST_ISSUES_ASSIGNED_TO_THE_AUTHENTICATED_USER", "LIST_ORG_ISSUES_FOR_THE_AUTHENTICATED_USER", "CREATE_AN_ISSUE", "LIST_SUB_ISSUES", "LIST_PULL_REQUESTS"] },
    { "consumer": "CREATE_AN_ISSUE_COMMENT", "param": "body", "must": [], "ok": [] },
    { "consumer": "ADD_LABELS_TO_AN_ISSUE", "param": "issue_number",
      "must": ["LIST_REPOSITORY_ISSUES"],
      "ok": ["SEARCH_ISSUES", "SEARCH_ISSUES_AND_PULL_REQUESTS", "LIST_ISSUES_ASSIGNED_TO_THE_AUTHENTICATED_USER", "LIST_ORG_ISSUES_FOR_THE_AUTHENTICATED_USER", "CREATE_AN_ISSUE", "LIST_SUB_ISSUES", "LIST_PULL_REQUESTS"] },
    { "consumer": "ADD_LABELS_TO_AN_ISSUE", "param": "labels",
      "must": ["LIST_LABELS_FOR_A_REPOSITORY"],
      "ok": ["LIST_LABELS_FOR_AN_ISSUE", "LIST_LABELS_FOR_ISSUES_IN_A_MILESTONE", "CREATE_A_LABEL"] },
    { "consumer": "MERGE_A_PULL_REQUEST", "param": "pull_number",
      "must": ["LIST_PULL_REQUESTS"],
      "ok": ["FIND_PULL_REQUESTS", "SEARCH_ISSUES_AND_PULL_REQUESTS", "CREATE_A_PULL_REQUEST", "LIST_PULL_REQUESTS_ASSOCIATED_WITH_A_COMMIT", "GET_PULL_REQUESTS"] },
    { "consumer": "SUBMIT_A_REVIEW_FOR_A_PULL_REQUEST", "param": "pull_number",
      "must": ["LIST_PULL_REQUESTS"],
      "ok": ["FIND_PULL_REQUESTS", "SEARCH_ISSUES_AND_PULL_REQUESTS", "CREATE_A_PULL_REQUEST", "LIST_PULL_REQUESTS_ASSOCIATED_WITH_A_COMMIT", "GET_PULL_REQUESTS"] },
    { "consumer": "SUBMIT_A_REVIEW_FOR_A_PULL_REQUEST", "param": "review_id",
      "must": ["LIST_REVIEWS_FOR_A_PULL_REQUEST"],
      "ok": ["CREATE_A_REVIEW_FOR_A_PULL_REQUEST"] },
    { "consumer": "SUBMIT_A_REVIEW_FOR_A_PULL_REQUEST", "param": "event", "must": [], "ok": [] },
    { "consumer": "CREATE_A_REVIEW_COMMENT_FOR_A_PULL_REQUEST", "param": "commit_id",
      "must": ["LIST_COMMITS_ON_A_PULL_REQUEST"],
      "ok": ["GET_A_PULL_REQUEST", "LIST_PULL_REQUESTS", "FIND_PULL_REQUESTS", "LIST_COMMITS"] },
    { "consumer": "RE_RUN_A_WORKFLOW", "param": "run_id",
      "must": ["LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY"],
      "ok": ["LIST_WORKFLOW_RUNS_FOR_A_WORKFLOW"] },
    { "consumer": "DOWNLOAD_AN_ARTIFACT", "param": "artifact_id",
      "must": ["LIST_ARTIFACTS_FOR_A_REPOSITORY", "LIST_WORKFLOW_RUN_ARTIFACTS"],
      "ok": [] },
    { "consumer": "CREATE_A_WORKFLOW_DISPATCH_EVENT", "param": "workflow_id",
      "must": ["LIST_REPOSITORY_WORKFLOWS"],
      "ok": ["LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY"] },
    { "consumer": "CREATE_A_WORKFLOW_DISPATCH_EVENT", "param": "ref",
      "must": ["LIST_BRANCHES"],
      "ok": ["LIST_MATCHING_REFERENCES", "LIST_REPOSITORY_TAGS", "GET_A_REPOSITORY", "LIST_BRANCHES_FOR_HEAD_COMMIT"] },
    { "consumer": "LIST_CHECK_RUNS_IN_A_CHECK_SUITE", "param": "check_suite_id",
      "must": ["LIST_CHECK_SUITES_FOR_A_GIT_REFERENCE"],
      "ok": ["LIST_CHECK_RUNS_FOR_A_REF", "LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY", "LIST_WORKFLOW_RUNS_FOR_A_WORKFLOW", "CREATE_A_CHECK_SUITE"] },
    { "consumer": "UPDATE_A_REPOSITORY_WEBHOOK", "param": "hook_id",
      "must": ["LIST_REPOSITORY_WEBHOOKS"],
      "ok": ["CREATE_A_REPOSITORY_WEBHOOK"] },
    { "consumer": "DELETE_A_REPOSITORY_WEBHOOK", "param": "hook_id",
      "must": ["LIST_REPOSITORY_WEBHOOKS"],
      "ok": ["CREATE_A_REPOSITORY_WEBHOOK"] },
    { "consumer": "DELETE_A_REPOSITORY_SECRET", "param": "secret_name",
      "must": ["LIST_REPOSITORY_SECRETS"],
      "ok": ["LIST_REPO_SECRETS_WITHOUT_VALUES", "LIST_REPOSITORY_SECRETS_WITHOUT_DECRYPTING"] },
    { "consumer": "ADD_OR_UPDATE_TEAM_REPOSITORY_PERMISSIONS", "param": "team_slug",
      "must": ["LIST_TEAMS"],
      "ok": ["LIST_TEAMS_FOR_THE_AUTHENTICATED_USER", "LIST_REPOSITORY_TEAMS", "LIST_CHILD_TEAMS", "LIST_TEAMS_THAT_ARE_ASSIGNED_TO_AN_ORGANIZATION_ROLE", "GET_ORGANIZATION_TEAMS"] },
    { "consumer": "GET_A_TEAM_BY_NAME", "param": "team_slug",
      "must": ["LIST_TEAMS"],
      "ok": ["LIST_TEAMS_FOR_THE_AUTHENTICATED_USER", "LIST_REPOSITORY_TEAMS", "LIST_CHILD_TEAMS", "LIST_TEAMS_THAT_ARE_ASSIGNED_TO_AN_ORGANIZATION_ROLE", "GET_ORGANIZATION_TEAMS"] },
    { "consumer": "GET_A_BRANCH", "param": "branch",
      "must": ["LIST_BRANCHES"],
      "ok": ["LIST_BRANCHES_FOR_HEAD_COMMIT", "LIST_MATCHING_REFERENCES", "FIND_PULL_REQUESTS", "LIST_PULL_REQUESTS", "GET_A_REPOSITORY"] },
    { "consumer": "GET_A_COMMIT", "param": "ref",
      "must": ["LIST_COMMITS"],
      "ok": ["LIST_BRANCHES", "LIST_MATCHING_REFERENCES", "LIST_COMMITS_ON_A_PULL_REQUEST", "LIST_PULL_REQUESTS", "LIST_REPOSITORY_TAGS", "LIST_BRANCHES_FOR_HEAD_COMMIT"] },
    { "consumer": "UPDATE_A_RELEASE", "param": "release_id",
      "must": ["LIST_RELEASES"],
      "ok": ["CREATE_A_RELEASE", "GET_THE_LATEST_RELEASE", "GET_A_RELEASE_BY_TAG_NAME"] },
    { "consumer": "UPDATE_A_GIST", "param": "gist_id",
      "must": ["LIST_GISTS_FOR_THE_AUTHENTICATED_USER"],
      "ok": ["LIST_GISTS_FOR_A_USER", "LIST_PUBLIC_GISTS", "LIST_STARRED_GISTS", "CREATE_A_GIST"] },
    { "consumer": "UPDATE_AN_ISSUE_COMMENT", "param": "comment_id",
      "must": ["LIST_ISSUE_COMMENTS", "LIST_ISSUE_COMMENTS_FOR_A_REPOSITORY"],
      "ok": ["CREATE_AN_ISSUE_COMMENT"] },
    { "consumer": "DELETE_A_SELF_HOSTED_RUNNER_FROM_AN_ORGANIZATION", "param": "runner_id",
      "must": ["LIST_SELF_HOSTED_RUNNERS_FOR_AN_ORGANIZATION"],
      "ok": [] },
    { "consumer": "UPDATE_A_MILESTONE", "param": "milestone_number",
      "must": ["LIST_MILESTONES"],
      "ok": ["CREATE_A_MILESTONE", "LIST_REPOSITORY_ISSUES"] },
    { "consumer": "GET_AN_ENVIRONMENT", "param": "environment_name",
      "must": ["LIST_ENVIRONMENTS"],
      "ok": ["LIST_DEPLOYMENTS", "CREATE_OR_UPDATE_AN_ENVIRONMENT"] },
    { "consumer": "CREATE_A_DEPLOYMENT_STATUS", "param": "deployment_id",
      "must": ["LIST_DEPLOYMENTS"],
      "ok": ["CREATE_A_DEPLOYMENT"] },
    { "consumer": "CREATE_A_DEPLOYMENT_STATUS", "param": "state", "must": [], "ok": [] },
    { "consumer": "CREATE_AN_ISSUE", "param": "title", "must": [], "ok": [] },
    { "consumer": "CREATE_A_REPOSITORY_FOR_THE_AUTHENTICATED_USER", "param": "name", "must": [], "ok": [] }
  ]
}
