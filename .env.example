# Copy to .env and fill in. .env is gitignored; this example file is committed.

# AI API credentials from your Litmus assessment page (any OpenAI-compatible endpoint works).
LLM_API_KEY=
LLM_BASE_URL=

# Model id from the OpenRouter catalog (https://openrouter.ai/models).
DEP_GRAPH_MODEL=openai/gpt-4o

# Set to 0 to skip the LLM pass and use rule-based inference only.
# DEP_GRAPH_LLM=0
